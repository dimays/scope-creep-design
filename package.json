{
  "name": "@scope-creep/design",
  "version": "0.2.0",
  "description": "Scope Creep's shared design system: runtime CSS-variable tokens + headless primitives.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./src/tokens.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "sideEffects": [
    "*.css"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "bootstrap": "bun install",
    "test": "tsc --noEmit && biome check && vitest run",
